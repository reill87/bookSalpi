# Supabase project credentials.
# stockontext와 같은 Supabase 프로젝트를 공유합니다 (schema 'chaeksalpi'로 격리).
# 값은 stockontext의 .env.local 또는 Supabase Studio → Project Settings → API에서 복사.

# 클라이언트(브라우저)에 노출됩니다. PUBLIC_ prefix 필수.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 서버/워커 전용. 절대 클라이언트에 노출하지 마세요.
# 분석 워커가 RLS bypass 필요 시 사용. UI 빌드만 한다면 필요 없음.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 배포 도메인. SEO 메타 태그(canonical, OG)와 OAuth redirect 절대경로에 사용.
PUBLIC_SITE_URL=https://booksalpi.local
