---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { PickStatus, Book } from "../../lib/database.types";

// 미들웨어가 이미 미인증 사용자를 /login으로 보냅니다.
const user = Astro.locals.user!;

interface PickRow {
  status: PickStatus;
  personal_note: string | null;
  added_at: string;
  updated_at: string;
  book: Pick<
    Book,
    "id" | "title" | "author" | "category" | "cover_url" | "status"
  >;
}

const { data, error } = await Astro.locals.supabase
  .from("user_picks")
  .select(
    "status, personal_note, added_at, updated_at, book:book_id(id, title, author, category, cover_url, status)",
  )
  .eq("user_id", user.id)
  .order("updated_at", { ascending: false })
  .returns<PickRow[]>();

if (error) {
  throw new Error(`user_picks fetch failed: ${error.message}`);
}

const picks = data ?? [];
const groups: Record<PickStatus, PickRow[]> = {
  reading: picks.filter((p) => p.status === "reading"),
  wishlist: picks.filter((p) => p.status === "wishlist"),
  read: picks.filter((p) => p.status === "read"),
};

const labels: Record<PickStatus, string> = {
  reading: "읽는 중",
  wishlist: "위시리스트",
  read: "완독",
};
const order: PickStatus[] = ["reading", "wishlist", "read"];
---

<BaseLayout title="내 책장 — 책살피">
  <section class="space-y-8">
    <header>
      <h1 class="text-2xl font-bold tracking-tight">내 책장</h1>
      <p class="mt-1 text-sm text-neutral-600">
        {user.email} · 총 {picks.length}권
      </p>
    </header>

    {
      picks.length === 0 ? (
        <p class="rounded border border-dashed border-neutral-300 p-8 text-center text-sm text-neutral-500">
          아직 등록된 책이 없습니다.{" "}
          <a href="/books" class="text-blue-600 hover:underline">
            책 목록
          </a>
          에서 책을 위시·읽는 중·완독으로 추가해보세요.
        </p>
      ) : (
        order
          .filter((s) => groups[s].length > 0)
          .map((s) => (
            <section>
              <h2 class="text-lg font-semibold">
                {labels[s]} ({groups[s].length})
              </h2>
              <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {groups[s].map((p) => (
                  <li>
                    <a
                      href={`/books/${p.book.id}`}
                      class="flex gap-3 rounded-lg border border-neutral-200 bg-white p-3 transition hover:border-neutral-400"
                    >
                      {p.book.cover_url && (
                        <img
                          src={p.book.cover_url}
                          alt=""
                          class="h-24 w-16 flex-none rounded object-cover"
                          loading="lazy"
                        />
                      )}
                      <div class="min-w-0 flex-1">
                        <div class="truncate font-medium">{p.book.title}</div>
                        {p.book.author && (
                          <div class="truncate text-sm text-neutral-600">
                            {p.book.author}
                          </div>
                        )}
                        {p.personal_note && (
                          <p class="mt-1 line-clamp-2 text-xs text-neutral-500">
                            {p.personal_note}
                          </p>
                        )}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
      )
    }
  </section>
</BaseLayout>
