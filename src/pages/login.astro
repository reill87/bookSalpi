---
import BaseLayout from "../layouts/BaseLayout.astro";

if (Astro.locals.user) {
  return Astro.redirect("/");
}

const next = Astro.url.searchParams.get("next") ?? "/";
const mode =
  Astro.url.searchParams.get("mode") === "signup" ? "signup" : "login";
const error = Astro.url.searchParams.get("error");
---

<BaseLayout title={mode === "signup" ? "회원가입 — 책살피" : "로그인 — 책살피"}>
  <section class="mx-auto max-w-sm space-y-6">
    <header>
      <h1 class="text-2xl font-bold tracking-tight">
        {mode === "signup" ? "회원가입" : "로그인"}
      </h1>
      <p class="mt-1 text-sm text-neutral-600">
        {
          mode === "signup"
            ? "이메일과 비밀번호로 새 계정을 만듭니다."
            : "책 등록 · 책장 관리에 로그인이 필요합니다."
        }
      </p>
    </header>

    {
      error && (
        <div class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {error}
        </div>
      )
    }

    <form
      method="POST"
      action={mode === "signup" ? "/api/auth/signup" : "/api/auth/login"}
      class="space-y-3 rounded-lg border border-neutral-200 bg-white p-5"
    >
      <input type="hidden" name="next" value={next} />
      <div>
        <label for="email" class="block text-sm font-medium">이메일</label>
        <input
          type="email"
          name="email"
          id="email"
          required
          autocomplete="email"
          class="mt-1 block w-full rounded border border-neutral-300 px-3 py-2 text-sm"
        />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium">비밀번호</label>
        <input
          type="password"
          name="password"
          id="password"
          required
          minlength="8"
          autocomplete={mode === "signup" ? "new-password" : "current-password"}
          class="mt-1 block w-full rounded border border-neutral-300 px-3 py-2 text-sm"
        />
        {
          mode === "signup" && (
            <p class="mt-1 text-xs text-neutral-500">8자 이상</p>
          )
        }
      </div>
      <button
        type="submit"
        class="w-full rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-700"
      >
        {mode === "signup" ? "회원가입" : "로그인"}
      </button>
    </form>

    <form method="POST" action="/api/auth/google" class="space-y-2">
      <input type="hidden" name="next" value={next} />
      <button
        type="submit"
        class="w-full rounded border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50"
      >
        Google 계정으로 계속하기
      </button>
    </form>

    <p class="text-center text-sm text-neutral-600">
      {
        mode === "signup" ? (
          <>
            이미 계정이 있으신가요?{" "}
            <a
              href={`/login?next=${encodeURIComponent(next)}`}
              class="text-blue-600 hover:underline"
            >
              로그인
            </a>
          </>
        ) : (
          <>
            계정이 없으신가요?{" "}
            <a
              href={`/login?mode=signup&next=${encodeURIComponent(next)}`}
              class="text-blue-600 hover:underline"
            >
              회원가입
            </a>
          </>
        )
      }
    </p>
  </section>
</BaseLayout>
