---
import { supabase } from "../../lib/supabase";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type {
  Book,
  Analysis,
  ReadingCost,
  SimilarBook,
  RawSource,
  PickStatus,
} from "../../lib/database.types";
import {
  classifySources,
  summarizeTrust,
  TRUST_LABEL,
  TRUST_BADGE_CLASS,
} from "../../lib/source-trust";
import { extractChapters, isFictionLike } from "../../lib/chapters";
import type { ChapterNote } from "../../lib/database.types";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/books");
}

const { data: book, error: bookErr } = await supabase
  .from("books")
  .select("*")
  .eq("id", id)
  .single<Book>();

if (bookErr || !book) {
  return new Response("책을 찾을 수 없습니다.", { status: 404 });
}

const { data: analyses } = await supabase
  .from("analyses")
  .select("*")
  .eq("book_id", id)
  .order("generated_at", { ascending: false })
  .limit(1)
  .returns<Analysis[]>();

const analysis = analyses?.[0];

const similarBooks = (analysis?.similar_books ?? []) as SimilarBook[];
const readingCost = analysis?.reading_cost as ReadingCost | null;
const rawSources = (analysis?.raw_sources ?? []) as RawSource[];
const trustedSources = classifySources(rawSources);
const trust = summarizeTrust(trustedSources);

const sourceTypeLabel: Record<RawSource["type"], string> = {
  naver_blog: "네이버 블로그",
  aladin_review: "알라딘",
  kyobo_review: "교보문고",
  blog: "블로그",
  other: "기타",
};

// 로그인 사용자라면 본인의 pick을 가져옴
const user = Astro.locals.user;
let pickStatus: PickStatus | null = null;
let pickNote: string = "";
let noteBefore: string = "";
let noteAfter: string = "";
let chapterNotes: Record<string, ChapterNote> = {};
if (user) {
  const { data: pick } = await Astro.locals.supabase
    .from("user_picks")
    .select("status, personal_note, note_before, note_after, chapter_notes")
    .eq("user_id", user.id)
    .eq("book_id", id)
    .maybeSingle<{
      status: PickStatus;
      personal_note: string | null;
      note_before: string | null;
      note_after: string | null;
      chapter_notes: Record<string, ChapterNote> | null;
    }>();
  if (pick) {
    pickStatus = pick.status;
    pickNote = pick.personal_note ?? "";
    noteBefore = pick.note_before ?? "";
    noteAfter = pick.note_after ?? "";
    chapterNotes = pick.chapter_notes ?? {};
  }
}

const chapters = isFictionLike(book.category) ? extractChapters(book.toc) : [];

const pickLabels: Record<PickStatus, string> = {
  wishlist: "위시리스트",
  reading: "읽는 중",
  read: "완독",
};
const pickOrder: PickStatus[] = ["wishlist", "reading", "read"];
---

<BaseLayout
  title={`${book.title} — 책살피`}
  description={book.description
    ? book.description.slice(0, 160)
    : `${book.title} 4관점 분석`}
  ogImage={book.cover_url ?? undefined}
  ogType="article"
>
  <article class="space-y-10">
    <header class="flex flex-col gap-6 sm:flex-row sm:items-start">
      {
        book.cover_url && (
          <img
            src={book.cover_url}
            alt={`${book.title} 표지`}
            class="h-56 w-40 flex-none rounded object-cover shadow"
            loading="eager"
          />
        )
      }
      <div class="min-w-0 flex-1 space-y-2">
        {
          book.category && (
            <span class="inline-block rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">
              {book.category}
            </span>
          )
        }
        <h1 class="text-3xl font-bold tracking-tight">{book.title}</h1>
        {book.author && <p class="text-neutral-700">{book.author}</p>}
        <dl
          class="grid grid-cols-2 gap-x-4 gap-y-1 pt-2 text-sm text-neutral-600"
        >
          {
            book.publisher && (
              <>
                <dt class="text-neutral-500">출판사</dt>
                <dd>{book.publisher}</dd>
              </>
            )
          }
          {
            book.published_date && (
              <>
                <dt class="text-neutral-500">출간일</dt>
                <dd>{book.published_date}</dd>
              </>
            )
          }
          {
            book.isbn && (
              <>
                <dt class="text-neutral-500">ISBN</dt>
                <dd class="font-mono text-xs">{book.isbn}</dd>
              </>
            )
          }
        </dl>
        {
          book.source_url && (
            <p class="pt-2 text-sm">
              <a
                href={book.source_url}
                class="text-blue-600 hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                원본 페이지 →
              </a>
            </p>
          )
        }
        {
          book.added_context && (
            <p class="pt-2 text-sm text-neutral-500">
              <span class="font-medium text-neutral-700">등록 메모: </span>
              {book.added_context}
            </p>
          )
        }
      </div>
    </header>

    {
      user ? (
        <section class="rounded-lg border border-neutral-200 bg-white p-5">
          <h2 class="text-sm font-medium text-neutral-500">내 책장</h2>
          <form method="POST" action="/api/picks/upsert" class="mt-3 space-y-3">
            <input type="hidden" name="book_id" value={book.id} />
            <input type="hidden" name="next" value={`/books/${book.id}`} />
            <fieldset class="flex flex-wrap gap-2 text-sm">
              {pickOrder.map((s) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="status"
                    value={s}
                    class="peer sr-only"
                    checked={pickStatus === s}
                    required
                  />
                  <span class="rounded border border-neutral-300 px-3 py-1.5 peer-checked:border-neutral-900 peer-checked:bg-neutral-900 peer-checked:text-white">
                    {pickLabels[s]}
                  </span>
                </label>
              ))}
            </fieldset>
            <div>
              <label
                for="note_before"
                class="block text-sm font-medium text-neutral-700"
              >
                읽기 전: 끌린 이유 / 기대
              </label>
              <textarea
                name="note_before"
                id="note_before"
                rows="2"
                class="mt-1 block w-full rounded border border-neutral-300 px-3 py-2 text-sm"
                placeholder="이 책에 끌린 이유, 읽기 전의 기대"
                set:html={noteBefore}
              />
            </div>
            <div>
              <label
                for="note_after"
                class="block text-sm font-medium text-neutral-700"
              >
                읽고 난 후: 변화
              </label>
              <textarea
                name="note_after"
                id="note_after"
                rows="2"
                class="mt-1 block w-full rounded border border-neutral-300 px-3 py-2 text-sm"
                placeholder="읽기 전 X에 대한 내 생각이 후 Y로 변했다 — 식의 회고"
                set:html={noteAfter}
              />
            </div>
            <details class="text-sm text-neutral-500">
              <summary class="cursor-pointer">기타 메모</summary>
              <textarea
                name="personal_note"
                rows="2"
                class="mt-2 block w-full rounded border border-neutral-300 px-3 py-2 text-sm"
                placeholder="자유 메모 (legacy)"
                set:html={pickNote}
              />
            </details>
            <div class="flex items-center gap-3">
              <button
                type="submit"
                class="rounded bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-700"
              >
                저장
              </button>
              {pickStatus && (
                <button
                  type="submit"
                  formaction="/api/picks/delete"
                  class="text-sm text-neutral-500 hover:text-red-600"
                >
                  책장에서 빼기
                </button>
              )}
            </div>
          </form>

          {chapters.length > 0 && (
            <details class="mt-5 border-t border-neutral-200 pt-4">
              <summary class="cursor-pointer text-sm font-medium text-neutral-700">
                단편/장 별 메모 ({chapters.length}편) — {book.category} 분야
                자동 활성화
              </summary>
              <form
                method="POST"
                action="/api/picks/chapters"
                class="mt-3 space-y-2"
              >
                <input type="hidden" name="book_id" value={book.id} />
                <input type="hidden" name="next" value={`/books/${book.id}`} />
                <ul class="space-y-2">
                  {chapters.map((title) => {
                    const cn = chapterNotes[title];
                    return (
                      <li class="grid grid-cols-[auto_1fr] items-center gap-2 rounded border border-neutral-200 bg-neutral-50 p-2 text-sm">
                        <label class="flex cursor-pointer items-center gap-2">
                          <input
                            type="checkbox"
                            name={`chapter[${title}][read]`}
                            checked={cn?.read ?? false}
                          />
                          <span class="font-medium">{title}</span>
                        </label>
                        <input
                          type="text"
                          name={`chapter[${title}][note]`}
                          value={cn?.note ?? ""}
                          maxlength="500"
                          placeholder="이 편에 대한 한 줄 메모"
                          class="rounded border border-neutral-300 px-2 py-1 text-sm"
                        />
                      </li>
                    );
                  })}
                </ul>
                <button
                  type="submit"
                  class="rounded bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-neutral-700"
                >
                  단편 메모 저장
                </button>
              </form>
            </details>
          )}
        </section>
      ) : (
        <p class="text-sm text-neutral-500">
          <a
            href={`/login?next=/books/${book.id}`}
            class="text-blue-600 hover:underline"
          >
            로그인
          </a>
          하면 위시·읽는 중·완독 상태와 메모를 저장할 수 있습니다.
        </p>
      )
    }

    {
      book.description && (
        <section class="rounded-lg border border-neutral-200 bg-white p-5">
          <h2 class="mb-2 text-sm font-medium text-neutral-500">책 소개</h2>
          <p class="leading-relaxed whitespace-pre-line text-neutral-800">
            {book.description}
          </p>
        </section>
      )
    }

    {
      analysis ? (
        <div class="space-y-8">
          <div class="border-t border-neutral-200 pt-6 text-sm text-neutral-500">
            <span class="font-medium text-neutral-700">분석</span>
            {" · "}생성{" "}
            {new Date(analysis.generated_at).toLocaleDateString("ko-KR")}
            {" · 모델 "}
            {analysis.model_version} ({analysis.prompt_version})
          </div>

          <section>
            <h2 class="text-lg font-semibold">누구에게 좋은가</h2>
            <p class="mt-3 leading-relaxed whitespace-pre-line text-neutral-800">
              {analysis.target_reader ?? "정보 부족"}
            </p>
          </section>

          <section>
            <h2 class="text-lg font-semibold">비슷한 책과의 차이</h2>
            {similarBooks.length > 0 ? (
              <ul class="mt-3 space-y-3">
                {similarBooks.map((sb) => (
                  <li class="rounded-lg border border-neutral-200 bg-white p-4">
                    <div class="font-medium">{sb.title}</div>
                    {sb.author && (
                      <div class="text-sm text-neutral-600">{sb.author}</div>
                    )}
                    <p class="mt-2 text-sm leading-relaxed text-neutral-800">
                      {sb.diff}
                    </p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3 text-neutral-500">정보 부족</p>
            )}
          </section>

          <section>
            <h2 class="text-lg font-semibold">약점/한계</h2>
            <p class="mt-3 leading-relaxed whitespace-pre-line text-neutral-800">
              {analysis.weaknesses ?? "정보 부족"}
            </p>
          </section>

          <section>
            <h2 class="text-lg font-semibold">읽는 비용</h2>
            {readingCost ? (
              <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-4">
                <div>
                  <dt class="text-sm text-neutral-500">분량</dt>
                  <dd class="font-medium">
                    {readingCost.pages != null ? `${readingCost.pages}쪽` : "—"}
                  </dd>
                </div>
                <div>
                  <dt class="text-sm text-neutral-500">난이도</dt>
                  <dd class="font-medium">{readingCost.difficulty ?? "—"}</dd>
                </div>
                <div>
                  <dt class="text-sm text-neutral-500">예상 시간</dt>
                  <dd class="font-medium">
                    {readingCost.est_hours != null
                      ? `${readingCost.est_hours}시간`
                      : "—"}
                  </dd>
                </div>
                <div class="col-span-2 sm:col-span-1">
                  <dt class="text-sm text-neutral-500">번역</dt>
                  <dd class="text-sm">{readingCost.translation ?? "—"}</dd>
                </div>
              </dl>
            ) : (
              <p class="mt-3 text-neutral-500">정보 부족</p>
            )}
          </section>

          {rawSources.length > 0 && (
            <section>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-lg font-semibold">
                  출처 ({rawSources.length})
                </h2>
                <div class="flex flex-wrap gap-1.5 text-xs">
                  {trust.independent > 0 && (
                    <span class="rounded bg-emerald-100 px-2 py-0.5 text-emerald-800">
                      독립 {trust.independent}
                    </span>
                  )}
                  {trust.sponsored > 0 && (
                    <span class="rounded bg-amber-100 px-2 py-0.5 text-amber-800">
                      협찬 {trust.sponsored}
                    </span>
                  )}
                  {trust.promotional > 0 && (
                    <span class="rounded bg-orange-100 px-2 py-0.5 text-orange-800">
                      마케팅 {trust.promotional}
                    </span>
                  )}
                  {trust.meta > 0 && (
                    <span class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-600">
                      메타 {trust.meta}
                    </span>
                  )}
                </div>
              </div>
              {trust.independent + trust.sponsored + trust.promotional > 0 && (
                <p class="mt-1 text-xs text-neutral-500">
                  독자 후기 중 독립 후기{" "}
                  {Math.round(trust.independentRatio * 100)}% — 다른 도서
                  서비스가 잘 보여주지 않는 정보입니다.
                </p>
              )}
              <ul class="mt-3 space-y-2 text-sm">
                {trustedSources.map((src) => (
                  <li class="rounded border border-neutral-200 bg-white p-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs text-neutral-600">
                        {sourceTypeLabel[src.type] ?? src.type}
                      </span>
                      <span
                        class={`rounded px-1.5 py-0.5 text-xs ${TRUST_BADGE_CLASS[src.trust]}`}
                        title={src.trustReason ?? undefined}
                      >
                        {TRUST_LABEL[src.trust]}
                      </span>
                      <a
                        href={src.url}
                        class="truncate text-blue-600 hover:underline"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {src.url}
                      </a>
                    </div>
                    <p class="mt-1 leading-relaxed text-neutral-700">
                      {src.summary}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      ) : (
        <p class="text-neutral-500">분석 데이터가 없습니다.</p>
      )
    }
  </article>
</BaseLayout>
